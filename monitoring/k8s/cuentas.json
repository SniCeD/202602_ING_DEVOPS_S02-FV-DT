                                       }
                                   ]
                   },
                   {
                       "id":  4,
                       "type":  "timeseries",
                       "title":  "Uso de CPU y memoria JVM",
                       "gridPos":  {
                                       "h":  8,
                                       "w":  12,
                                       "x":  0,
                                       "y":  8
                                   },
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "bytes"
                                                        },
                                           "overrides":  [
                                                             {
                                                                 "matcher":  {
                                                                                 "id":  "byName",
                                                                                 "options":  "CPU del proceso"
                                                                             },
                                                                 "properties":  [
                                                                                    {
                                                                                        "id":  "unit",
                                                                                        "value":  "percentunit"
                                                                                    },
                                                                                    {
                                                                                        "id":  "custom.axisPlacement",
                                                                                        "value":  "right"
                                                                                    }
                                                                                ]
                                                             }
                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "sum(jvm_memory_used_bytes{job=\"cuentas-svc\"})",
                                           "legendFormat":  "Memoria JVM"
                                       },
                                       {
                                           "refId":  "B",
                                           "legendFormat":  "CPU del proceso",
                                           "expr":  "avg(process_cpu_usage{job=\"cuentas-svc\"})"
                                       }
                                   ],
                       "description":  "CPU media de los procesos de Cuentas y memoria JVM total de las réplicas."
                   },
                   {
                       "id":  2,
                       "type":  "timeseries",
                       "title":  "Errores registrados y HTTP 5xx",
                       "gridPos":  {
                                       "h":  8,
                                       "w":  12,
                                       "x":  12,
                                       "y":  8
