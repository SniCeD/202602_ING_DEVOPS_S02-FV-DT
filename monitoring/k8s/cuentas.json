                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "percent"
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "options":  {
                                       "reduceOptions":  {
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ],
                                                             "fields":  "",
                                                             "values":  false
