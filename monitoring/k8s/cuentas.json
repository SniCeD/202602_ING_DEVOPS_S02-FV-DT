                                       },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "sum(rate(http_server_requests_seconds_count{job=\"cuentas-svc\",uri!~\"/actuator.*\",status=~\"5..\"}[2m]))",
                                           "legendFormat":  "HTTP 5xx/s"
                                       },
                                       {
                                           "refId":  "B",
                                           "legendFormat":  "Logs ERROR/s",
                                           "expr":  "sum(rate(logback_events_total{job=\"cuentas-svc\",level=\"error\"}[2m]))"
                                       }
                                   ],
                       "description":  "Tasa de eventos ERROR de Logback y de respuestas HTTP 5xx. Son señales distintas y pueden coincidir."
                   },
                   {
                       "id":  1,
                       "type":  "timeseries",
