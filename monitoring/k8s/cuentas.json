                 "to":  "now"
             },
    "panels":  [
                   {
                       "id":  5,
                       "type":  "stat",
                       "title":  "Tiempo de despliegue en EKS",
                       "description":  "Desde el inicio de apply de Cuentas hasta verificar el rollout, el Service y las sondas.",
                       "gridPos":  {
                                       "h":  8,
                                       "w":  12,
                                       "x":  0,
                                       "y":  0
                                   },
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "s"
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "options":  {
                                       "reduceOptions":  {
                                                             "calcs":  [
                                                                           "lastNotNull"
                                                                       ],
                                                             "fields":  "",
                                                             "values":  false
                                                         },
                                       "graphMode":  "none",
                                       "colorMode":  "none"
                                   },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "instant":  true,
                                           "range":  false,
                                           "expr":  "novabank_ci_deploy_duration_seconds{job=\"novabank-ci\"}"
                                       }
                                   ]
                   },
                   {
                       "id":  6,
                       "type":  "stat",
