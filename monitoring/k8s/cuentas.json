                                           "overrides":  [

                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "sum(rate(http_server_requests_seconds_count{job=\"cuentas-svc\",uri!~\"/actuator.*\"}[2m]))"
                                       }
                                   ]
                   },
                   {
                       "id":  3,
                       "type":  "timeseries",
                       "title":  "Latencia HTTP p95",
                       "gridPos":  {
                                       "h":  8,
                                       "w":  12,
                                       "x":  12,
                                       "y":  16
                                   },
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "prometheus"
                                      },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "s"
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"cuentas-svc\",uri!~\"/actuator.*\"}[2m])))"
                                       }
                                   ]
                   },
                   {
