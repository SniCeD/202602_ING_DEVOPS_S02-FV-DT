loki.source.file "cuentas_logs" {
  targets = [
    {
      __path__    = "/var/log/cuentas/*.log",
      job         = "cuentas-svc",
      application = "cuentas-svc",
    },
  ]

  forward_to = [loki.write.local.receiver]

  file_match {
    enabled     = true
    sync_period = "5s"
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}